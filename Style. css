
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f4f4;
}

header {
    background: #17221f;
    color: white;
    padding: 20px 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
}

header h1 {
    color: #c9f36a;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 10px;
}

button, .shop-btn {
    background: #c9f36a;
    color: #17221f;
    padding: 10px 18px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    text-decoration: none;
}

.hero {
    background: #dce9ce;
    text-align: center;
    padding: 80px 20px;
}

.hero h2 {
    font-size: 40px;
    margin-bottom: 15px;
}

.hero p {
    margin-bottom: 25px;
}

#products {
    padding: 50px 5%;
    text-align: center;
}

#products h2 {
    margin-bottom: 30px;
}

.product-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.product {
    background: white;
    padding: 15px;
    border-radius: 10px;
    box-shadow: 0 3px 10px #00000015;
}

.product img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 8px;
}

.product h3 {
    margin: 15px 0;
}

.product p {
    margin-bottom: 15px;
    font-weight: bold;
}

.cart-section {
    background: white;
    margin: 30px 5%;
    padding: 25px;
    border-radius: 10px;
}

.cart-section h2 {
    margin-bottom: 15px;
}

#cartItems {
    line-height: 2;
}

footer {
    background: #17221f;
    color: white;
    text-align: center;
    padding: 25px;
}

@media (max-width: 768px) {
    .product-container {
        grid-template-columns: repeat(2, 1fr);
    }

    header {
        justify-content: center;
    }

    .hero h2 {
        font-size: 30px;
    }
}

@media (max-width: 450px) {
    .product-container {
        grid-template-columns: 1fr;
    }
}

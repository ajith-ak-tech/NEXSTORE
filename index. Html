
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NexStore - Online Shopping</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<header>
    <h1>NEXSTORE</h1>

    <nav>
        <a href="#">Home</a>
        <a href="#products">Products</a>
        <a href="#contact">Contact</a>
    </nav>

    <button onclick="showCart()">
        🛒 Cart (<span id="count">0</span>)
    </button>
</header>

<section class="hero">
    <h2>Welcome to NexStore</h2>
    <p>Discover amazing products at the best prices.</p>
    <a href="#products" class="shop-btn">Shop Now</a>
</section>

<section id="products">
    <h2>Our Products</h2>

    <div class="product-container">

        <div class="product">
            <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30b?w=500" alt="Headphones">
            <h3>Headphones</h3>
            <p>₹1,499</p>
            <button onclick="addToCart('Headphones',1499)">
                Add to Cart
            </button>
        </div>

        <div class="product">
            <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500" alt="Watch">
            <h3>Smart Watch</h3>
            <p>₹2,499</p>
            <button onclick="addToCart('Smart Watch',2499)">
                Add to Cart
            </button>
        </div>

        <div class="product">
            <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=500" alt="Shoes">
            <h3>Sports Shoes</h3>
            <p>₹1,999</p>
            <button onclick="addToCart('Sports Shoes',1999)">
                Add to Cart
            </button>
        </div>

        <div class="product">
            <img src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=500" alt="Camera">
            <h3>Camera</h3>
            <p>₹5,999</p>
            <button onclick="addToCart('Camera',5999)">
                Add to Cart
            </button>
        </div>

    </div>
</section>

<section class="cart-section">
    <h2>Shopping Cart</h2>
    <div id="cartItems">Your cart is empty.</div>
    <h3>Total: ₹<span id="total">0</span></h3>
    <button onclick="checkout()">Checkout</button>
</section>

<footer id="contact">
    <p>© 2026 NexStore. All Rights Reserved.</p>
    <p>Contact: support@nexstore.com</p>
</footer>

<script src="script.js"></script>
</body>
</html>
